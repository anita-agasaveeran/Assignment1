  "prep_log": [
    {
      "step": "item_frequency_floor",
      "detail": "kept 2,547/3,793 items appearing in >= 30 baskets",
      "rationale": "Items below the floor cannot reach any useful min_support, but they inflate the FP-tree and the search space."
    },
    {
      "step": "basket_size_filter",
      "detail": "kept 17,982/19,673 baskets with 2 <= size <= 200",
      "rationale": "Size-1 baskets cannot support a rule; oversized baskets are wholesale orders whose co-occurrence is an artefact of bulk picking rather than shopper intent."
